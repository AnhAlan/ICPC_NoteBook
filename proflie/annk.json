{
    "Fenwick Template": {
        "prefix": "fren",
        "body": [
            "struct Fenwick {",
            "    int n;",
            "    vector<int> BIT;",
            "",
            "    Fenwick(int n) : n(n), BIT(n+1, 0) {}",
            "",
            "    void update(int i, int val) {",
            "        for (; i <= n; i += (i & -i)) {",
            "            BIT[i] += val;",
            "        }",
            "    }",
            "",
            "    int query(int i) {",
            "        int sum = 0;",
            "        for (; i > 0; i -= (i & -i)) {",
            "            sum += BIT[i];",
            "        }",
            "        return sum;",
            "    }",
            "",
            "    int rangeQuery(int l, int r) {",
            "        return query(r) - query(l - 1);",
            "    }",
            "};"
        ],
        "description": "Fenwick Tree (Binary Indexed Tree) template"
    },

    "LCA Binary Lifting Template": {
        "prefix": "lca",
        "body": [
            "#define LOG 10",
            "const int MAXN = 1000;",
            "vector<int> adj[MAXN];",
            "int par[MAXN][LOG+1];",
            "int high[MAXN];",
            "int n;",
            "",
            "void load() {",
            "    cin >> n;",
            "    for(int i = 1; i <= n-1; i++) {",
            "        int u, v;",
            "        cin >> u >> v;",
            "        adj[u].push_back(v);",
            "        adj[v].push_back(u);",
            "    }",
            "}",
            "",
            "void dfs(int u) {",
            "    for(int v : adj[u]) {",
            "        if(v != par[u][0]) {",
            "            par[v][0] = u;",
            "            high[v] = high[u] + 1;",
            "            dfs(v);",
            "        }",
            "    }",
            "}",
            "",
            "void build_lca() {",
            "    for(int j = 1; j <= LOG; j++) {",
            "        for(int i = 1; i <= n; i++) {",
            "            if(par[i][j-1])",
            "                par[i][j] = par[par[i][j-1]][j-1];",
            "        }",
            "    }",
            "}",
            "",
            "int lca(int u, int v) {",
            "    if(high[v] > high[u]) swap(u, v);",
            "    for(int i = LOG; i >= 0; i--) {",
            "        if(high[par[u][i]] >= high[v]) {",
            "            u = par[u][i];",
            "        }",
            "    }",
            "    if(u == v) return u;",
            "    for(int i = LOG; i >= 0; i--) {",
            "        if(par[u][i] != par[v][i]) {",
            "            u = par[u][i];",
            "            v = par[v][i];",
            "        }",
            "    }",
            "    return par[u][0];",
            "}"
        ],
        "description": "LCA Binary Lifting Template"
    },

	"2D Point Geometry Template": {
        "prefix": "point",
        "body": [
            "// Constants",
            "const long double PI = acosl(-1.0L); // Pi",
            "const double EPS = 1e-9; // Tolerance for comparing doubles",

            "// Struct for 2D point / vector",
            "struct Point {",
            "    double x, y; // Coordinates",
            "    Point(double x = 0, double y = 0) : x(x), y(y) {}",

            "    // Vector addition / subtraction",
            "    Point operator + (const Point &o) const { return Point(x + o.x, y + o.y); } // a + b",
            "    Point operator - (const Point &o) const { return Point(x - o.x, y - o.y); } // a - b",
            "    Point operator * (double k) const { return Point(x * k, y * k); } // Scale by k",
            "    Point operator / (double k) const { return Point(x / k, y / k); } // Divide by k",

            "    // Dot product: a·b = |a||b|cosθ",
            "    double dot(const Point &o) const { return x * o.x + y * o.y; } // Used for angle, projection",

            "    // Cross product (2D): a×b = signed area of parallelogram",
            "    double cross(const Point &o) const { return x * o.y - y * o.x; }",
            "    // Cross for 3 points: (b-a)×(c-a) >0 CCW, <0 CW, 0 collinear",
            "    double cross(const Point &b, const Point &c) const { return (b - *this).cross(c - *this); }",

            "    // Vector length |v| and squared length |v|^2",
            "    double len() const { return sqrt(x*x + y*y); }",
            "    double len2() const { return x*x + y*y; } // Avoid sqrt if not needed",

            "    // Distance between points",
            "    double dist(const Point &o) const { return (*this - o).len(); }",
            "    double dist2(const Point &o) const { return (*this - o).len2(); } // Optimized for comparisons",

            "    // Rotate around origin (0,0) by rad radians CCW",
            "    Point rotate(double rad) const {",
            "        double cosA = cos(rad), sinA = sin(rad);",
            "        return Point(x * cosA - y * sinA, x * sinA + y * cosA);",
            "    }",

            "    // Rotate around another point o by rad radians CCW",
            "    Point rotate(const Point &o, double rad) const {",
            "        return (*this - o).rotate(rad) + o;",
            "    }",

            "    // Comparison for sorting: first by x, then by y",
            "    bool operator < (const Point &o) const {",
            "        if (fabs(x - o.x) > EPS) return x < o.x;",
            "        return y < o.y;",
            "    }",

            "    // Equality check with tolerance EPS",
            "    bool operator == (const Point &o) const {",
            "        return fabs(x - o.x) < EPS && fabs(y - o.y) < EPS;",
            "    }",
            "};",

            "// Reference point for polar sorting (convex hull, etc.)",
            "Point p0;",

            "// Polar angle comparison for sorting points CCW around p0",
            "bool polar_cmp(const Point &a, const Point &b) {",
            "    double angA = atan2(a.y - p0.y, a.x - p0.x);",
            "    double angB = atan2(b.y - p0.y, b.x - p0.x);",
            "    if (fabs(angA - angB) > EPS) return angA < angB;",
            "    return a.dist2(p0) < b.dist2(p0); // Closer point first if same angle",
            "}",

            "// Orientation of 3 points: >0 CCW, <0 CW, =0 collinear",
            "double orientation(const Point &a, const Point &b, const Point &c) {",
            "    return (b - a).cross(c - a);",
            "}",

            "// Check if point c is on segment a-b",
            "bool onSegment(const Point &a, const Point &b, const Point &c) {",
            "    if (fabs(orientation(a,b,c)) > EPS) return false;",
            "    return c.x >= min(a.x,b.x)-EPS && c.x <= max(a.x,b.x)+EPS &&",
            "           c.y >= min(a.y,b.y)-EPS && c.y <= max(a.y,b.y)+EPS;",
            "}",

            "// Angle between 2 vectors a and b in radians",
            "double angle(const Point &a, const Point &b) {",
            "    double cosA = a.dot(b)/(a.len()*b.len());",
            "    return acos(max(-1.0, min(1.0, cosA)));",
            "}"
        ],
        "description": "2D Point geometry template (vector ops, cross, rotate, dist, orientation, polar sort) with English notes"
    },
	
	"Sieve of Eratosthenes Template": {
        "prefix": "sieve",
        "body": [
            "const int N = 1000000;",
            "bool isPrime[N+1];",
            "",
            "void sieve() {",
            "    fill(isPrime, isPrime + N + 1, true);",
            "    isPrime[0] = isPrime[1] = false;",
            "    for(int i = 2; i * i <= N; i++) {",
            "        if(isPrime[i]) {",
            "            for(int j = i * i; j <= N; j += i)",
            "                isPrime[j] = false;",
            "        }",
            "    }",
            "}"
        ],
        "description": "Sieve of Eratosthenes template for primes"
    },

	"Sieve + SPF Factorization Template": {
        "prefix": "spf",
        "body": [
            "const int N = 1000000;",
            "int primeDiv[N + 1];",
            "",
            "void sieve_spf() {",
            "    for (int i = 2; 1LL * i * i <= N; i++) {",
            "        if (primeDiv[i] == 0) {",
            "            for (int j = i * i; j <= N; j += i)",
            "                primeDiv[j] = i;",
            "        }",
            "    }",
            "    for (int i = 2; i <= N; i++) {",
            "        if (primeDiv[i] == 0) primeDiv[i] = i;",
            "    }",
            "}",
            "",
            "vector<pair<int,int>> factor(int x) {",
            "    vector<pair<int,int>> res;",
            "    while(x > 1) {",
            "        int p = primeDiv[x];",
            "        res.push_back({p,0});",
            "        while(x % p == 0) {",
            "            res.back().second++;",
            "            x /= p;",
            "        }",
            "    }",
            "    return res;",
            "}"
        ],
        "description": "Sieve of Eratosthenes with SPF and factorization"
    },

	"DSU Template": {
        "prefix": "dsu",
        "body": [
            "struct DSU {",
            "    vector<int> parent, Size;",
            "    int n;",
            "    DSU(int _n) : n(_n) {",
            "        parent.resize(n+1);",
            "        Size.resize(n+1);",
            "        for(int i = 1; i <= n; i++) {",
            "            parent[i] = i;",
            "            Size[i] = 1;",
            "        }",
            "    }",
            "",
            "    int find(int a) {",
            "        if(parent[a] == a) return a;",
            "        return parent[a] = find(parent[a]);",
            "    }",
            "",
            "    void unite(int a, int b) {",
            "        a = find(a);",
            "        b = find(b);",
            "        if(a == b) return;",
            "        if(Size[a] < Size[b]) swap(a, b);",
            "        parent[b] = a;",
            "        Size[a] += Size[b];",
            "    }",
            "",
            "    bool same(int a, int b) {",
            "        return find(a) == find(b);",
            "    }",
            "};"
        ],
        "description": "Disjoint Set Union (DSU) template"
    },

	"Dijkstra Template": {
        "prefix": "dijkstra",
        "body": [
            "void dijkstra(int s) {",
            "    vector<long long> d(n+1, INF);",
            "    d[s] = 0;",
            "    priority_queue<pair<long long,int>, vector<pair<long long,int>>, greater<pair<long long,int>>> Q;",
            "    Q.push({0, s});",
            "    while(!Q.empty()) {",
            "        auto [w, u] = Q.top();",
            "        Q.pop();",
            "        if(w > d[u]) continue;",
            "        for(auto it : adj[u]) {",
            "            int v = it.first;",
            "            long long kc_new = it.second;",
            "            if(d[v] > d[u] + kc_new) {",
            "                d[v] = d[u] + kc_new;",
            "                Q.push({d[v], v});",
            "            }",
            "        }",
            "    }",
            "}"
        ],
        "description": "Dijkstra shortest path template using priority_queue"
    },

	"Dinic Max Flow Template": {
        "prefix": "dinic",
        "body": [
            "struct Edge {",
            "    int to, rev;",
            "    long long cap;",
            "};",
            "",
            "struct Dinic {",
            "    int n;",
            "    vector<vector<Edge>> adj;",
            "    vector<int> level, ptr;",
            "",
            "    Dinic(int _n) : n(_n) {",
            "        adj.assign(n + 1, {});",
            "        level.assign(n + 1, 0);",
            "        ptr.assign(n + 1, 0);",
            "    }",
            "",
            "    void add(int u, int v, long long cap) {",
            "        Edge a = {v, (int)adj[v].size(), cap};",
            "        Edge b = {u, (int)adj[u].size(), 0};",
            "        adj[u].push_back(a);",
            "        adj[v].push_back(b);",
            "    }",
            "",
            "    bool bfs(int s, int t) {",
            "        fill(level.begin(), level.end(), -1);",
            "        queue<int> q;",
            "        q.push(s);",
            "        level[s] = 0;",
            "        while(!q.empty()) {",
            "            int u = q.front(); q.pop();",
            "            for(auto &e : adj[u]) {",
            "                if(e.cap > 0 && level[e.to] == -1) {",
            "                    level[e.to] = level[u] + 1;",
            "                    q.push(e.to);",
            "                }",
            "            }",
            "        }",
            "        return level[t] != -1;",
            "    }",
            "",
            "    long long dfs(int u, int t, long long pushed) {",
            "        if(!pushed) return 0;",
            "        if(u == t) return pushed;",
            "        for(int &i = ptr[u]; i < (int)adj[u].size(); i++) {",
            "            Edge &e = adj[u][i];",
            "            if(level[e.to] != level[u] + 1 || e.cap <= 0) continue;",
            "            long long tr = dfs(e.to, t, min(pushed, e.cap));",
            "            if(tr == 0) continue;",
            "            e.cap -= tr;",
            "            adj[e.to][e.rev].cap += tr;",
            "            return tr;",
            "        }",
            "        return 0;",
            "    }",
            "",
            "    long long maxFlow(int s, int t) {",
            "        long long flow = 0;",
            "        while(bfs(s, t)) {",
            "            fill(ptr.begin(), ptr.end(), 0);",
            "            while(long long pushed = dfs(s, t, 1e18))",
            "                flow += pushed;",
            "        }",
            "        return flow;",
            "    }",
            "};"
        ],
        "description": "Dinic's algorithm template for Max Flow"
    },

	"Bipartite Matching Template": {
        "prefix": "aug",
        "body": [
            "const int MAX = 1000;",
            "bool vis[MAX];",
            "int matchL[MAX], matchR[MAX];",
            "",
            "bool dfs(int u) {",
            "    for(int v : adj[u]) {",
            "        if(!vis[v]) {",
            "            vis[v] = true;",
            "            if(!matchR[v] || dfs(matchR[v])) {",
            "                matchL[u] = v;",
            "                matchR[v] = u;",
            "                return true;",
            "            }",
            "        }",
            "    }",
            "    return false;",
            "}",
            "",
            "int maxMatching(int n) {",
            "    memset(matchL, 0, sizeof(matchL));",
            "    memset(matchR, 0, sizeof(matchR));",
            "    int res = 0;",
            "    for(int u = 1; u <= n; u++) {",
            "        memset(vis, 0, sizeof(vis));",
            "        if(dfs(u)) res++;",
            "    }",
            "    return res;",
            "}"
        ],
        "description": "Bipartite Matching (Hungarian Algorithm) template"
    },

	"Heavy-Light Decomposition Template": {
        "prefix": "hld",
        "body": [
			"const int MAXN = 200005;",
			"int par[MAXN], high[MAXN], heavy[MAXN], head[MAXN], pos[MAXN], sz[MAXN];",
			"int cnt = 0; ",
			"int edge_to_node[MAXN];",
            "void dfs(int u, int p) {",
            "    par[u] = p;",
            "    sz[u] = 1;",
            "    int max_sz = 0;",
            "    for(auto [v, idx] : adj[u]) {",
            "        if(v == p) continue;",
            "        high[v] = high[u] + 1;",
            "        dfs(v, u);",
            "        sz[u] += sz[v];",
            "        if(sz[v] > max_sz) {",
            "            max_sz = sz[v];",
            "            heavy[u] = v;",
            "        }",
            "        edge_to_node[idx] = v;",
            "    }",
            "}",
            "",
            "void decompose(int u, int h) {",
            "    head[u] = h;",
            "    pos[u] = ++cnt;",
            "    if(heavy[u]) decompose(heavy[u], h);",
            "    for(auto [v, idx] : adj[u]) {",
            "        if(v == par[u] || v == heavy[u]) continue;",
            "        decompose(v, v);",
            "    }",
            "}"
        ],
        "description": "Heavy-Light Decomposition (HLD) template for path queries on trees"
    },


	"Segment Tree with Lazy Template": {
        "prefix": "seg",
        "body": [
            "struct Node {",
            "    ll val;",
            "    Node(ll _val = 0) {",
            "        val = _val;",
            "    }",
            "};",
            "",
            "struct SegTree {",
            "    int n;",
            "    vector<Node> seg;",
            "    vector<ll> lazy;",
            "",
            "    SegTree(int _n) : n(_n) {",
            "        seg.assign(4*n, Node(0));",
            "        lazy.assign(4*n, 0);",
            "    }",
            "",
            "    void apply(int id, int l, int r, ll w) {",
            "        seg[id].val = w;",
            "        lazy[id] = w;",
            "    }",
            "",
            "    void push(int id, int l, int r) {",
            "        if(lazy[id] != 0) {",
            "            int mid = (l + r) / 2;",
            "            apply(id*2, l, mid, lazy[id]);",
            "            apply(id*2+1, mid+1, r, lazy[id]);",
            "            lazy[id] = 0;",
            "        }",
            "    }",
            "",
            "    void pull(int id) {",
            "        seg[id].val = max(seg[id*2].val, seg[id*2+1].val);",
            "    }",
            "",
            "    void build(int id, int l, int r, const vector<ll>& a) {",
            "        lazy[id] = 0;",
            "        if(l == r){",
            "            seg[id] = Node(a[l]);",
            "            return;",
            "        }",
            "        int mid = (l + r) / 2;",
            "        build(id*2, l, mid, a);",
            "        build(id*2+1, mid+1, r, a);",
            "        pull(id);",
            "    }",
            "",
            "    void update(int id, int l, int r, int u, int v, ll w) {",
            "        if(r < u || v < l) return;",
            "        if(u <= l && r <= v){",
            "            apply(id, l, r, w);",
            "            return;",
            "        }",
            "        push(id, l, r);",
            "        int mid = (l + r) / 2;",
            "        update(id*2, l, mid, u, v, w);",
            "        update(id*2+1, mid+1, r, u, v, w);",
            "        pull(id);",
            "    }",
            "",
            "    void update_point(int id, int l, int r, int pos, ll w) {",
            "        if(l == r){",
            "            seg[id] = Node(w);",
            "            lazy[id] = 0;",
            "            return;",
            "        }",
            "        push(id, l, r);",
            "        int mid = (l + r) / 2;",
            "        if(pos <= mid) update_point(id*2, l, mid, pos, w);",
            "        else update_point(id*2+1, mid+1, r, pos, w);",
            "        pull(id);",
            "    }",
            "",
            "    ll query(int id, int l, int r, int u, int v) {",
            "        if(r < u || v < l) return LLONG_MIN;",
            "        if(u <= l && r <= v) return seg[id].val;",
            "        push(id, l, r);",
            "        int mid = (l + r) / 2;",
            "        return max(query(id*2, l, mid, u, v), query(id*2+1, mid+1, r, u, v));",
            "    }",
            "}"
        ],
        "description": "Segment Tree template with lazy propagation for range max update/query"
    },

     "Ordered Set (Unique Elements)": {
        "prefix": "oset",
        "body": [
            "#include <ext/pb_ds/assoc_container.hpp>",
            "#include <ext/pb_ds/tree_policy.hpp>",
            "using namespace __gnu_pbds;",

            "// ordered_set: set with order statistics, no duplicates",
            "template<class T>",
            "using ordered_set = tree<",
            "    T,                                  // key type",
            "    null_type,                          // mapped type (set)",
            "    less<T>,                            // comparison function",
            "    rb_tree_tag,                        // red-black tree",
            "    tree_order_statistics_node_update   // supports order statistics",
            ">;",

            "// Example usage:",
            "// ordered_set<int> os;",
            "// os.insert(x)         -> insert x (ignored if exists)",
            "// os.erase(x)          -> remove x",
            "// os.count(x)          -> 0/1, check existence",
            "// os.find(x)           -> iterator to x or os.end()",
            "// os.order_of_key(x)   -> number of elements < x",
            "// os.find_by_order(k)  -> iterator to k-th element (0-indexed)",
            "// *os.begin()          -> smallest element",
            "// *os.rbegin()         -> largest element",
            "// os.size()            -> number of elements"
        ],
        "description": "PBDS ordered_set (unique elements) with English notes"
    },

