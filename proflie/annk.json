    "Fenwick Tree / BIT": {
        "prefix": "fen",
        "body": [
        "struct FenwickTree {",
        "    int n;",
        "    vector<int> BIT;",
        "",
        "    FenwickTree(int n) : n(n) {",
        "        BIT.assign(n + 1, 0);",
        "    }",
        "",
        "    void update(int idx, int val) {",
        "        for (; idx <= n; idx += (idx & -idx)) {",
        "            BIT[idx] += val;",
        "        }",
        "    }",
        "",
        "    int query(int idx) {",
        "        int res = 0;",
        "        for (; idx > 0; idx -= (idx & -idx)) {",
        "            res += BIT[idx];",
        "        }",
        "        return res;",
        "    }",
        "",
        "    int rangeQuery(int l, int r) {",
        "        return query(r) - query(l - 1);",
        "    }",
        "};"
        ],
        "description": "Fenwick Tree (Binary Indexed Tree) 1-indexed for point update and range sum"
    },


    "2D Fenwick Tree / BIT": {
        "prefix": "fenwick2d",
        "body": [
        "struct FenwickTree2D {",
        "    int n, m;",
        "    vector<vector<long long>> BIT;",
        "",
        "    // Constructor",
        "    FenwickTree2D(int n, int m) : n(n), m(m) {",
        "        BIT.assign(n + 1, vector<long long>(m + 1, 0));",
        "    }",
        "",
        "    // Update position (x, y) by val",
        "    void update(int x, int y, int val) {",
        "        for (int i = x; i <= n; i += i & -i) {",
        "            for (int j = y; j <= m; j += j & -j) {",
        "                BIT[i][j] += val;",
        "            }",
        "        }",
        "    }",
        "",
        "    // Query prefix sum (1,1) to (x,y)",
        "    long long query(int x, int y) {",
        "        long long sum = 0;",
        "        for (int i = x; i > 0; i -= i & -i) {",
        "            for (int j = y; j > 0; j -= j & -j) {",
        "                sum += BIT[i][j];",
        "            }",
        "        }",
        "        return sum;",
        "    }",
        "",
        "    // Query sum of rectangle (x1, y1) to (x2, y2)",
        "    long long getSum(int x1, int y1, int x2, int y2) {",
        "        return query(x2, y2)",
        "             - query(x1 - 1, y2)",
        "             - query(x2, y1 - 1)",
        "             + query(x1 - 1, y1 - 1);",
        "    }",
        "};"
        ],
        "description": "2D Fenwick Tree (Binary Indexed Tree) for point update and rectangle sum"
    },


    "Sparse Table / RMQ": {
        "prefix": "sparse",
        "body": [
        "const int MAXN = 1e6 + 5;",
        "const int LOG = 20;",
        "int n, a[MAXN];",
        "int minV[MAXN][LOG]; // Sparse Table: minV[i][j] = min in [i,i+2^j-1]",
        "",
        "// Build Sparse Table",
        "void build() {",
        "    for (int i = 1; i <= n; i++)",
        "        minV[i][0] = a[i]; // intervals of length 1",
        "",
        "    for (int j = 1; (1 << j) <= n; j++) {",
        "        for (int i = 1; i + (1 << j) - 1 <= n; i++) {",
        "            minV[i][j] = min(minV[i][j - 1], minV[i + (1 << (j - 1))][j - 1]);",
        "        }",
        "    }",
        "}",
        "",
        "// Query minimum in range [l, r]",
        "int getMin(int l, int r) {",
        "    int k = 31 - __builtin_clz(r - l + 1); // floor(log2(length))",
        "    return min(minV[l][k], minV[r - (1 << k) + 1][k]);",
        "}"
        ],
        "description": "Sparse Table for Range Minimum Query (RMQ) O(n log n) build, O(1) query"
    },


