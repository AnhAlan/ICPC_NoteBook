    	"Dijkstra Template": {
        "prefix": "dijkstra",
        "body": [
            "void dijkstra(int s) {",
            "    vector<long long> d(n+1, INF);",
            "    d[s] = 0;",
            "    priority_queue<pair<long long,int>, vector<pair<long long,int>>, greater<pair<long long,int>>> Q;",
            "    Q.push({0, s});",
            "    while(!Q.empty()) {",
            "        auto [w, u] = Q.top();",
            "        Q.pop();",
            "        if(w > d[u]) continue;",
            "        for(auto it : adj[u]) {",
            "            int v = it.first;",
            "            long long kc_new = it.second;",
            "            if(d[v] > d[u] + kc_new) {",
            "                d[v] = d[u] + kc_new;",
            "                Q.push({d[v], v});",
            "            }",
            "        }",
            "    }",
            "}"
        ],
        "description": "Dijkstra shortest path template using priority_queue"
    },

	"DSU Template": {
        "prefix": "dsu",
        "body": [
            "struct DSU {",
            "    vector<int> parent, Size;",
            "    int n;",
            "    DSU(int _n) : n(_n) {",
            "        parent.resize(n+1);",
            "        Size.resize(n+1);",
            "        for(int i = 1; i <= n; i++) {",
            "            parent[i] = i;",
            "            Size[i] = 1;",
            "        }",
            "    }",
            "",
            "    int find(int a) {",
            "        if(parent[a] == a) return a;",
            "        return parent[a] = find(parent[a]);",
            "    }",
            "",
            "    void unite(int a, int b) {",
            "        a = find(a);",
            "        b = find(b);",
            "        if(a == b) return;",
            "        if(Size[a] < Size[b]) swap(a, b);",
            "        parent[b] = a;",
            "        Size[a] += Size[b];",
            "    }",
            "",
            "    bool same(int a, int b) {",
            "        return find(a) == find(b);",
            "    }",
            "};"
        ],
        "description": "Disjoint Set Union (DSU) template"
    },

    "LCA Binary Lifting": {
        "prefix": "lca",
        "body": [
        "#define log 10",
        "const int maxn = 1000;",
        "int par[maxn][log + 1];",
        "int high[maxn];",
        "void dfs(int u) {",
        "    for (int v : adj[u]) {",
        "        if (v != par[u][0]) {",
        "            par[v][0] = u;",
        "            high[v] = high[u] + 1;",
        "            dfs(v);",
        "        }",
        "    }",
        "}",
        "",
        "void build_lca() {",
        "    for (int j = 1; j <= log; j++) {",
        "        for (int i = 1; i <= n; i++) {",
        "            if (par[i][j - 1])",
        "                par[i][j] = par[par[i][j - 1]][j - 1];",
        "        }",
        "    }",
        "}",
        "",
        "int lca(int u, int v) {",
        "    if (high[v] > high[u])",
        "        return lca(v, u);",
        "",
        "    for (int i = log; i >= 0; i--) {",
        "        if (par[u][i] && high[par[u][i]] >= high[v]) {",
        "            u = par[u][i];",
        "        }",
        "    }",
        "",
        "    if (u == v) return u;",
        "",
        "    for (int i = log; i >= 0; i--) {",
        "        if (par[u][i] != par[v][i]) {",
        "            u = par[u][i];",
        "            v = par[v][i];",
        "        }",
        "    }",
        "    return par[u][0];",
        "}"
        ],
        "description": "LCA using Binary Lifting (DFS + parent table)"
    },

