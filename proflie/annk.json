            "    for(size_t i = 0;i<v.size();i++){",
            "        os << v[i];",
            "        if(i+1<v.size()) os << \",\";",
            "    }",
            "    os << \"}\";",
            "    return os;",
            "}",
            "",
            "template<typename T>",
            "ostream& operator<<(ostream& os, const vector<vector<T>>& v) {",
            "    os << \"{ \";",
            "    for (size_t i = 0; i < v.size(); i++) {",
            "        os << \"[\";",
            "        for (size_t j = 0; j < v[i].size(); j++) {",
            "            os << v[i][j];",
            "            if (j + 1 < v[i].size()) os << \",\";",
            "        }",
            "        os << \"] \";",
            "    }",
            "    os << \" }\";",
            "    return os;",
            "}",
            "",
            "void dbg() {}",
            "",
            "template<typename T, typename... Args>",
            "void dbg(const T& a, const Args&... args){",
            "    cerr << a;",
            "    if(sizeof...(args)) cerr << \", \";",
            "    dbg(args...);",
            "}"
