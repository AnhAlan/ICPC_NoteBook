    "Heavy-Light Decomposition": {
        "prefix": "hld",
        "body": [
        "const int MAXN = 200005;",
        "int par[MAXN], high[MAXN], heavy[MAXN], head[MAXN], pos[MAXN], sz[MAXN];",
        "int cnt = 0;",
        "int edge_to_node[MAXN];",
        "",
        "// DFS to compute sizes, parents, heavy child",
        "void dfs(int u, int p) {",
        "    par[u] = p;",
        "    sz[u] = 1;",
        "    int max_sz = 0;",
        "    for (auto [v, idx] : adj[u]) {",
        "        if (v == p) continue;",
        "        high[v] = high[u] + 1;",
        "        dfs(v, u);",
        "        sz[u] += sz[v];",
        "        if (sz[v] > max_sz) {",
        "            max_sz = sz[v];",
        "            heavy[u] = v;",
        "        }",
        "        edge_to_node[idx] = v;",
        "    }",
        "}",
        "",
        "// Decompose tree into heavy-light chains",
        "void decompose(int u, int h) {",
        "    head[u] = h;",
        "    pos[u] = cnt++;",
        "    if (heavy[u]) decompose(heavy[u], h);",
        "    for (auto [v, idx] : g[u]) {",
        "        if (v == par[u] || v == heavy[u]) continue;",
        "        decompose(v, v);",
        "    }",
        "}"
