    "2D Point Geometry Template": {
        "prefix": "point",
        "body": [
            "// Constants",
            "const long double PI = acosl(-1.0L); // Pi",
            "const double EPS = 1e-9; // Tolerance for comparing doubles",

            "// Struct for 2D point / vector",
            "struct Point {",
            "    double x, y; // Coordinates",
            "    Point(double x = 0, double y = 0) : x(x), y(y) {}",

            "    // Vector addition / subtraction",
            "    Point operator + (const Point &o) const { return Point(x + o.x, y + o.y); } // a + b",
            "    Point operator - (const Point &o) const { return Point(x - o.x, y - o.y); } // a - b",
            "    Point operator * (double k) const { return Point(x * k, y * k); } // Scale by k",
            "    Point operator / (double k) const { return Point(x / k, y / k); } // Divide by k",

            "    // Dot product: a·b = |a||b|cosθ",
            "    double dot(const Point &o) const { return x * o.x + y * o.y; } // Used for angle, projection",

            "    // Cross product (2D): a×b = signed area of parallelogram",
            "    double cross(const Point &o) const { return x * o.y - y * o.x; }",
            "    // Cross for 3 points: (b-a)×(c-a) >0 CCW, <0 CW, 0 collinear",
            "    double cross(const Point &b, const Point &c) const { return (b - *this).cross(c - *this); }",

            "    // Vector length |v| and squared length |v|^2",
            "    double len() const { return sqrt(x*x + y*y); }",
            "    double len2() const { return x*x + y*y; } // Avoid sqrt if not needed",

            "    // Distance between points",
            "    double dist(const Point &o) const { return (*this - o).len(); }",
            "    double dist2(const Point &o) const { return (*this - o).len2(); } // Optimized for comparisons",

            "    // Rotate around origin (0,0) by rad radians CCW",
            "    Point rotate(double rad) const {",
            "        double cosA = cos(rad), sinA = sin(rad);",
            "        return Point(x * cosA - y * sinA, x * sinA + y * cosA);",
            "    }",

            "    // Rotate around another point o by rad radians CCW",
            "    Point rotate(const Point &o, double rad) const {",
            "        return (*this - o).rotate(rad) + o;",
            "    }",

            "    // Comparison for sorting: first by x, then by y",
            "    bool operator < (const Point &o) const {",
            "        if (fabs(x - o.x) > EPS) return x < o.x;",
            "        return y < o.y;",
            "    }",

            "    // Equality check with tolerance EPS",
            "    bool operator == (const Point &o) const {",
            "        return fabs(x - o.x) < EPS && fabs(y - o.y) < EPS;",
            "    }",
            "};",

            "// Reference point for polar sorting (convex hull, etc.)",
            "Point p0;",

            "// Polar angle comparison for sorting points CCW around p0",
            "bool polar_cmp(const Point &a, const Point &b) {",
            "    double angA = atan2(a.y - p0.y, a.x - p0.x);",
            "    double angB = atan2(b.y - p0.y, b.x - p0.x);",
            "    if (fabs(angA - angB) > EPS) return angA < angB;",
            "    return a.dist2(p0) < b.dist2(p0); // Closer point first if same angle",
            "}",

            "// Orientation of 3 points: >0 CCW, <0 CW, =0 collinear",
            "double orientation(const Point &a, const Point &b, const Point &c) {",
            "    return (b - a).cross(c - a);",
            "}",

            "// Check if point c is on segment a-b",
            "bool onSegment(const Point &a, const Point &b, const Point &c) {",
            "    if (fabs(orientation(a,b,c)) > EPS) return false;",
            "    return c.x >= min(a.x,b.x)-EPS && c.x <= max(a.x,b.x)+EPS &&",
            "           c.y >= min(a.y,b.y)-EPS && c.y <= max(a.y,b.y)+EPS;",
            "}",

            "// Angle between 2 vectors a and b in radians",
            "double angle(const Point &a, const Point &b) {",
            "    double cosA = a.dot(b)/(a.len()*b.len());",
            "    return acos(max(-1.0, min(1.0, cosA)));",
            "}"
        ],
        "description": "2D Point geometry template (vector ops, cross, rotate, dist, orientation, polar sort) with English notes"
    },

    "Convex Hull Monotonic Chain": {
        "prefix": "convex",
        "body": [
        "vector<Point> convexHull(vector<Point> v) {",
        "    int n = v.size();",
        "    if (n <= 2) return v;",
        "",
        "    sort(v.begin(), v.end());",
        "",
        "    vector<Point> ch(2 * n);",
        "    int sz = 0;",
        "",
        "    // Lower hull",
        "    for (int i = 0; i < n; i++) {",
        "        while (sz > 1 && cross(ch[sz - 2], ch[sz - 1], v[i]) <= 0)",
        "            sz--;",
        "        ch[sz++] = v[i];",
        "    }",
        "",
        "    // Upper hull",
        "    for (int i = n - 2, up = sz; i >= 0; i--) {",
        "        while (sz > up && cross(ch[sz - 2], ch[sz - 1], v[i]) <= 0)",
        "            sz--;",
        "        ch[sz++] = v[i];",
        "    }",
        "",
        "    ch.resize(sz - 1);",
        "    return ch;",
        "}"
        ],
        "description": "Convex Hull using Monotonic Chain (Andrew's algorithm)"
    },

    "Closest Pair Divide & Conquer": {
        "prefix": "close    ",
        "body": [
        "// Divide and conquer main function",
        "double closestUtil(vector<Point>& Px, vector<Point>& Py, int l, int r) {",
        "    int n = r - l + 1;",
        "    if (n <= 3) return bruteForce(Px, l, r);",
        "",
        "    int mid = (l + r) / 2;",
        "    double midx = Px[mid].x;",
        "",
        "    // Split Py into left/right",
        "    vector<Point> Pyl, Pyr;",
        "    for (auto& p : Py) {",
        "        if (p.x <= midx) Pyl.push_back(p);",
        "        else Pyr.push_back(p);",
        "    }",
        "",
        "    double dl = closestUtil(Px, Pyl, l, mid);",
        "    double dr = closestUtil(Px, Pyr, mid + 1, r);",
        "    double d = min(dl, dr);",
        "",
        "    // make strip",
        "    vector<Point> strip;",
        "    for (auto& p : Py) {",
        "        if (fabs(p.x - midx) < d) strip.push_back(p);",
        "    }",
        "",
        "    // Check in strip",
        "    for (int i = 0; i < (int)strip.size(); i++) {",
        "        for (int j = i + 1; j < (int)strip.size() && j <= i + 7; j++) {",
        "            d = min(d, dist(strip[i], strip[j]));",
        "        }",
        "    }",
        "",
        "    return d;",
        "}",
        "",
        "double closestPair(vector<Point>& P) {",
        "    int n = P.size();",
        "    vector<Point> Px = P, Py = P;",
        "    sort(Px.begin(), Px.end(), [](Point a, Point b) { return a.x < b.x; });",
        "    sort(Py.begin(), Py.end(), [](Point a, Point b) { return a.y < b.y; });",
        "    return closestUtil(Px, Py, 0, n - 1);",
        "}"
        ],
        "description": "Closest pair of points using divide and conquer (O(n log n))"
    },




