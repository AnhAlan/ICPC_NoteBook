    "LCA Euler Tour RMQ": {
        "prefix": "lca1",
        "body": [
        "const int maxn = 1000;",
        "",
        "int nodes[2 * maxn];",
        "int pos[maxn];",
        "int fin[maxn];",
        "int cnt = 0;",
        "int high[maxn];",
        "",
        "void dfs(int u, int par) {",
        "    nodes[++cnt] = u;",
        "    pos[u] = cnt;",
        "    for (int v : adj[u]) {",
        "        if (v != par) {",
        "            high[v] = high[u] + 1;",
        "            dfs(v, u);",
        "            nodes[++cnt] = u;",
        "        }",
        "    }",
        "    fin[u] = cnt;",
        "}",
        "",
        "int MinHigh(int u, int v) {",
        "    return high[u] < high[v] ? u : v;",
        "}",
        "",
        "#define LOG 10",
        "int minH[2 * maxn][maxn];",
        "",
        "void build() {",
        "    for (int i = 1; i <= cnt; i++) {",
        "        minH[i][0] = nodes[i];",
        "    }",
        "    for (int j = 1; j < LOG; j++) {",
        "        for (int i = 1; i <= cnt - MASK(j) + 1; i++) {",
        "            minH[i][j] = MinHigh(minH[i][j - 1], minH[i + MASK(j - 1)][j - 1]);",
        "        }",
        "    }",
        "}",
        "",
        "int lca(int u, int v) {",
        "    int pu = pos[u];",
        "    int pv = pos[v];",
        "    if (pu > pv) swap(pu, pv);",
        "    int k = 31 - __builtin_clz(pv - pu + 1);",
        "    return MinHigh(minH[pu][k], minH[pv - MASK(k) + 1][k]);",
        "}",
        "",
        ],
        "description": "LCA using Euler Tour + Sparse Table RMQ"
    },

    
    "Floyd Warshall with Path Reconstruction": {
        "prefix": "floyd",
        "body": [
        "const int INF = 1e9;",
        "int d[505][505], r[505][505];",
        "int n;",
        "",
        "// Reconstruct path from u to v",
        "void route(int u, int v) {",
        "    if (r[u][v] == 0) {",
        "        cout << v << \" \";",
        "    } else {",
        "        route(u, r[u][v]);",
        "        route(r[u][v], v);",
        "    }",
        "}",
        "",
        "// Floyd-Warshall",
        "void floyd() {",
        "    for (int k = 1; k <= n; k++) {",
        "        for (int i = 1; i <= n; i++) {",
        "            for (int j = 1; j <= n; j++) {",
        "                if (d[i][k] < INF && d[k][j] < INF",
        "                    && d[i][j] > d[i][k] + d[k][j]) {",
        "                    d[i][j] = d[i][k] + d[k][j];",
        "                    r[i][j] = k;",
        "                }",
        "            }",
        "        }",
        "    }",
        "}"
        ],
        "description": "Floyd-Warshall with path reconstruction (route function)"
    },


