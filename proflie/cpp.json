            "    Fenwick2D(int _n, int _m) : n(_n), m(_m), bit(_n + 1, vector<T>(_m + 1, 0)) {}",
            "    void update(int x, int y, T v) {",
            "        for(int i = x; i <= n; i += (i & -i)){",
            "            for(int j = y; j <= m; j += (j & -j)){",
            "                bit[i][j] += v;",
